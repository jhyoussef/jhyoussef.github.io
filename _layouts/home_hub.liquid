---
layout: default
---

<div class="home-hub-page">
  <header class="home-hub-header page-hero">
    <h1 class="home-hub-title page-hero-title">{{ page.title }}</h1>
    {% if page.subtitle %}
      <p class="home-hub-subtitle page-hero-subtitle">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <div class="row home-hub-row">
    <div class="col-lg-8 col-md-7 order-1 order-lg-1">
      <section class="home-section">
        <h2 class="home-section-title">projects</h2>

        {% assign featured_projects = site.projects | where: "featured", true | sort: "importance" %}
        <div class="home-projects-grid">
          {% for project in featured_projects limit: 3 %}
            <div class="home-project-card">
              <div class="card h-100 hoverable project-card">
                {% if project.img %}
                  <a href="{{ project.url | relative_url }}" class="card-media">
                    <img src="{{ project.img | relative_url }}" class="card-img-top" alt="{{ project.title }}">
                  </a>
                {% endif %}
                <div class="card-body">
                  <h5 class="card-title">
                    <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
                  </h5>
                  {% if project.description %}
                    <p class="card-text">{{ project.description }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </section>

      <section class="home-section">
        <h2 class="home-section-title">latest posts</h2>

        {% assign latest_writings_count = 0 %}
        {% for post in site.posts %}
          {% unless post.tags contains "notes" %}
            <div class="card mb-3 hoverable home-writing-card{% unless post.thumbnail %} home-writing-card--no-thumb{% endunless %}">
              {% if post.thumbnail %}
                <a class="home-writing-thumb" href="{{ post.url | relative_url }}">
                  <img src="{{ post.thumbnail | relative_url }}" alt="{{ post.title }}">
                </a>
              {% endif %}
              <div class="card-body home-writing-body">
                <h5 class="card-title mb-1">
                  <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
                </h5>
                {% if post.description %}
                  <p class="card-text mb-2">{{ post.description }}</p>
                {% endif %}
                <small class="text-muted">{{ post.date | date: "%B %-d, %Y" }}</small>
              </div>
            </div>
            {% assign latest_writings_count = latest_writings_count | plus: 1 %}
            {% if latest_writings_count >= 3 %}
              {% break %}
            {% endif %}
          {% endunless %}
        {% endfor %}
      </section>
    </div>

    <div class="col-lg-4 col-md-5 order-2 order-lg-2">
      <aside class="home-sidebar">
        <h2 class="home-column-label">profile</h2>

        {% if page.profile and page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% include figure.liquid
            loading="eager"
            path=profile_image_path
            class="img-fluid rounded z-depth-1 home-profile-img"
            alt=page.title
            cache_bust=true
          %}
        {% endif %}

        {% if page.short_bio %}
          <p class="home-blurb">{{ page.short_bio }}</p>
        {% endif %}

        {% if page.home_buttons %}
          <div class="home-buttons">
            {% for button in page.home_buttons %}
              {% assign button_href = button.url | strip %}

              {% unless button_href contains '://' or button_href contains '#' or button_href contains 'mailto:' or button_href contains 'tel:' %}
                {% assign resolved_button_doc = nil %}

                {% if button_href contains '.md' or button_href contains '.html' %}
                  {% assign resolved_button_doc = site.pages | where: "path", button_href | first %}

                  {% if resolved_button_doc == nil %}
                    {% assign resolved_button_doc = site.posts | where: "path", button_href | first %}
                  {% endif %}

                  {% if resolved_button_doc == nil %}
                    {% for collection in site.collections %}
                      {% assign collection_match = collection.docs | where: "path", button_href | first %}
                      {% if collection_match %}
                        {% assign resolved_button_doc = collection_match %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}

                  {% if resolved_button_doc %}
                    {% assign button_href = resolved_button_doc.url %}
                  {% endif %}
                {% endif %}

                {% assign button_href_prefix = button_href | slice: 0, 1 %}
                {% unless button_href_prefix == '/' %}
                  {% assign button_href = button_href | prepend: '/' %}
                {% endunless %}
              {% endunless %}

              <a class="home-button" href="{{ button_href | relative_url }}">{{ button.label }}</a>
            {% endfor %}
          </div>
        {% endif %}

        {% if page.announcements and page.announcements.enabled %}
            <section class="home-section mb-5">
                <h2 class="home-section-title">
                <a href="{{ '/news/' | relative_url }}" style="color: inherit;">news</a>
                </h2>
                {% include news.liquid limit=true %}
            </section>
        {% endif %}
        
      </aside>
    </div>
  </div>

  {% if page.social %}
    <div class="home-social">
      <div class="contact-icons">{% include social.liquid %}</div>
      <div class="contact-note">{{ site.contact_note }}</div>
    </div>
  {% endif %}
</div>
