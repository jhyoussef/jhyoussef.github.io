---
layout: default
---

<div class="home-hub-page">
  <header class="home-hub-header">
    <h1 class="home-hub-title">{{ page.title }}</h1>
    {% if page.subtitle %}
      <p class="home-hub-subtitle">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <div class="row home-hub-row">
    <div class="col-lg-9 col-md-8 order-1 order-lg-1">
      <section class="home-section">
        <h2 class="home-section-title">projects</h2>

        {% assign featured_projects = site.projects | where: "featured", true | sort: "importance" %}
        <div class="home-projects-grid">
          {% for project in featured_projects limit: 3 %}
            <div class="home-project-card">
              <div class="card h-100 hoverable">
                {% if project.img %}
                  <a href="{{ project.url | relative_url }}">
                    <img src="{{ project.img | relative_url }}" class="card-img-top" alt="{{ project.title }}">
                  </a>
                {% endif %}
                <div class="card-body">
                  <h5 class="card-title">
                    <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
                  </h5>
                  {% if project.description %}
                    <p class="card-text">{{ project.description }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </section>

      <section class="home-section">
        <h2 class="home-section-title">latest posts</h2>

        {% for post in site.posts limit: 3 %}
          <div class="card mb-3 hoverable">
            <div class="card-body">
              <h5 class="card-title mb-1">
                <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
              </h5>
              {% if post.description %}
                <p class="card-text mb-2">{{ post.description }}</p>
              {% endif %}
              <small class="text-muted">{{ post.date | date: "%B %-d, %Y" }}</small>
            </div>
          </div>
        {% endfor %}
      </section>
    </div>

    <div class="col-lg-3 col-md-4 order-2 order-lg-2">
      <aside class="home-sidebar">
        <h2 class="home-column-label">profile</h2>

        {% if page.profile and page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% include figure.liquid
            loading="eager"
            path=profile_image_path
            class="img-fluid rounded z-depth-1 home-profile-img"
            alt=page.title
            cache_bust=true
          %}
        {% endif %}

        {% if page.short_bio %}
          <p class="home-blurb">{{ page.short_bio }}</p>
        {% endif %}

        {% if page.home_buttons %}
          <div class="home-buttons">
            {% for button in page.home_buttons %}
              <a class="home-button" href="{{ button.url | relative_url }}">{{ button.label }}</a>
            {% endfor %}
          </div>
        {% endif %}

        {% if page.announcements and page.announcements.enabled %}
            <section class="home-section mb-5">
                <h2 class="home-section-title">
                <a href="{{ '/news/' | relative_url }}" style="color: inherit;">news</a>
                </h2>
                {% include news.liquid limit=true %}
            </section>
        {% endif %}
        
      </aside>
    </div>
  </div>

  {% if page.social %}
    <div class="home-social">
      <div class="contact-icons">{% include social.liquid %}</div>
      <div class="contact-note">{{ site.contact_note }}</div>
    </div>
  {% endif %}
</div>
