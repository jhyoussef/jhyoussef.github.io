---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  {{ content }}

  {% assign area_notes = site.notes | where: "area", page.slug | sort: "importance" %}
  {% assign modules = area_notes | map: "module" | uniq %}

  {% if area_notes.size > 0 %}
    {% for module_slug in modules %}
      {% assign module_notes = area_notes | where: "module", module_slug | sort: "importance" %}
      {% assign first_note = module_notes | first %}

      <section class="mt-4">
        <h2 class="category">
          {% if first_note.module_title %}
            {{ first_note.module_title }}
          {% else %}
            {{ module_slug | replace: "-", " " | capitalize }}
          {% endif %}
        </h2>

        <div class="projects-cards-grid">
          {% for note in module_notes %}
            <a href="{{ note.url | relative_url }}" class="text-decoration-none">
              <div class="card h-100 hoverable">
                {% if note.img %}
                  <img src="{{ note.img | relative_url }}" class="card-img-top" alt="{{ note.title }}">
                {% endif %}

                <div class="card-body">
                  <h5 class="card-title">{{ note.title }}</h5>

                  {% if note.description %}
                    <p class="card-text">{{ note.description }}</p>
                  {% endif %}

                  {% if note.type %}
                    <p class="card-text">
                      <small class="text-muted">{{ note.type }}</small>
                    </p>
                  {% endif %}
                </div>
              </div>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  {% else %}
    <p>No notes found for this area yet.</p>
  {% endif %}
</div>